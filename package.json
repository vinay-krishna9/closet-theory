{
  "name": "closet-theory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "catalog:prepare": "node --experimental-strip-types scripts/prepare-catalog.mjs",
    "photos:prepare": "node scripts/prepare-photo-assets.mjs",
    "dev": "npm run photos:prepare && next dev --hostname localhost",
    "build": "npm run photos:prepare && next build",
    "start": "next start --hostname localhost",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:account:entry": "playwright test --config playwright.account.config.ts",
    "test:account:live": "playwright test --config playwright.account-live.config.ts",
    "test:account:cleanup": "node --experimental-strip-types tests/account-live/cleanup.mts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test:import:db": "node scripts/test-import-db.mjs",
    "test:import:live": "playwright test --config playwright.import-live.config.ts",
    "test:wardrobe:db": "node scripts/test-import-db.mjs --wardrobe",
    "test:wardrobe:live": "playwright test --config playwright.wardrobe-live.config.ts",
    "test:outfits:live": "playwright test --config playwright.outfits-live.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.2",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "onnxruntime-web": "1.31.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@clerk/testing": "2.3.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
